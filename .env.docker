# نسخ هذا الملف إلى .env عند استخدام Docker

APP_NAME="Valex Hospital"
APP_ENV=local
APP_DEBUG=true
APP_URL=https://localhost

# ===== Database =====
# اسم الـ service في docker-compose وليس localhost
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=valex
DB_USERNAME=valex_user
DB_PASSWORD=valex_pass
DB_ROOT_PASSWORD=secret_root

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret

# ===== Cache + Queue + Session via Redis =====
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# ===== Sentry =====
SENTRY_LARAVEL_DSN=