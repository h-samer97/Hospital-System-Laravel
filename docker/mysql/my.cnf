[mysqld]
# ===== Character Set =====
character-set-server  = utf8mb4
collation-server      = utf8mb4_unicode_ci
default-authentication-plugin = mysql_native_password

# ===== InnoDB Performance =====
# Buffer Pool = ذاكرة تخزين MySQL المؤقتة
# القاعدة: 70-80% من RAM إذا MySQL الخادم الوحيد
innodb_buffer_pool_size     = 512M
innodb_buffer_pool_instances = 2     # موازاة = عدد الـ instances
innodb_log_file_size        = 256M
innodb_flush_log_at_trx_commit = 2   # 2 = أداء أفضل (يُفقد ثانية بيانات عند crash)
                                      # 1 = الأأمن تماماً (أبطأ قليلاً)
innodb_flush_method          = O_DIRECT
innodb_io_capacity          = 400

# ===== Connections =====
max_connections         = 100
max_connect_errors      = 100000
wait_timeout            = 600
interactive_timeout     = 600

# ===== Query Cache =====
# مُعطَّل في MySQL 8 (أُزيل رسمياً)
# Redis يتولى الـ caching الآن

# ===== Logging =====
slow_query_log          = 1
slow_query_log_file     = /var/log/mysql/slow.log
long_query_time         = 1         # سجّل الاستعلامات التي تتجاوز ثانية
log_queries_not_using_indexes = 1   # سجّل الاستعلامات بدون index